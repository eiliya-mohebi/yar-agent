# ── LLM (OpenAI chat.completions wire format via AvalAI) ─────────────────────
# AvalAI is OpenAI-compatible. Paste your AvalAI key and keep this base URL.
#   https://docs.avalai.ir/en/api-reference/authentication
OPENAI_API_KEY=
# Optional alias (used if OPENAI_API_KEY is empty):
# YAR_API_KEY=

# Default endpoint for this deployment (OpenAI-compatible):
YAR_BASE_URL=https://api.avalai.ir/v1

# Models (optional — defaults match docs/ARCHITECTURE.md §9):
# YAR_MODEL=gpt-5.3-chat-latest
# YAR_SMALL_MODEL=gpt-4.1-mini

# ── Yar home (optional) ─────────────────────────────────────────────────────
# Where memory (state.db), calendar.ics, outbox/ and traces/ live.
# YAR_HOME=.yar

# ── Loop guardrails (optional) ──────────────────────────────────────────────
# YAR_MAX_ITERATIONS=10
# YAR_MAX_TOKENS=8192
# Working memory window: how many recent turns enter the prompt (default 12).
# YAR_HISTORY_TURNS=12

# ── Memory tuning (optional) ────────────────────────────────────────────────
# YAR_CONSOLIDATE_EVERY=6
# YAR_RETRIEVAL_TOP_K=4

# ── Tracing (optional): uv sync --extra tracing ─────────────────────────────
# JSONL traces are ALWAYS written to $YAR_HOME/traces/. To also see them in
# a dashboard: run `make trace` (Phoenix on localhost:6006) and uncomment:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ── Experimental tools (optional) ───────────────────────────────────────────
# YAR_EXPERIMENTAL=1
# YAR_DELEGATE_TIMEOUT=300

# ── Web search (optional) ───────────────────────────────────────────────────
# search_web works keyless via DuckDuckGo; Tavily is more reliable when set:
# TAVILY_API_KEY=

# ── MCP servers (optional): uv sync --extra mcp ─────────────────────────────
# Create .yar/mcp.json to register servers. Absent by default.

# ── Reliability (optional) ──────────────────────────────────────────────────
# YAR_LLM_TIMEOUT=120

# ── Dashboard (optional) ────────────────────────────────────────────────────
# YAR_DASHBOARD_PORT=7777
